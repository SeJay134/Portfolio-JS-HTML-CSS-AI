{
  "name": "sergei-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5001",
    "build": "tsc -b && vite build && node --import tsx scripts/prerender.tsx",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test tests/e2e",
    "test:smoke": "playwright test tests/smoke",
    "test:regression": "playwright test tests/regression",
    "test:browser": "playwright test tests/smoke tests/e2e tests/regression",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src scripts/prerender.tsx vite.config.ts playwright.config.ts tests",
    "format": "prettier --write src scripts tests *.ts *.json *.md .github/workflows/ci.yml"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.58.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "jsdom": "30.1.1",
    "prettier": "3.7.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "engines": { "node": ">=22.12.0" }
}
