# Local AI backend only. Copy to .env; do not commit .env.
FRONTEND_URLS=http://127.0.0.1:5001,http://localhost:5001
TRUSTED_HOSTS=127.0.0.1,localhost
OLLAMA_HOST=http://127.0.0.1:11434
MODEL_NAME=qwen2.5:7b
MODEL_TIMEOUT=45
MAX_GENERATIONS=1
CHAT_LIMIT=10/minute
RATELIMIT_STORAGE_URI=memory://
LOCAL_API_PORT=5002

# Leave disabled for normal computer-only use.
# For an explicit temporary tunnel, configure its trusted host/origin and
# require a strong key. Never put this key in VITE_* or public frontend code.
REQUIRE_API_KEY=false
LOCAL_API_KEY=
