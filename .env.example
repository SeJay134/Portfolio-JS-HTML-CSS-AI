# Local AI backend only. Copy to .env; do not commit .env.
FRONTEND_URLS=http://127.0.0.1:5001,http://localhost:5001
TRUSTED_HOSTS=127.0.0.1,localhost
OLLAMA_HOST=http://127.0.0.1:11434
# Default for the portfolio assistant. Use 3b only as an explicit rollback.
MODEL_NAME=qwen2.5:7b
# Qwen 7B can take longer than the old 45-second limit.
MODEL_TIMEOUT=120
MAX_GENERATIONS=1
CHAT_LIMIT=10/minute
RATELIMIT_STORAGE_URI=memory://
LOCAL_API_PORT=5002

# Leave disabled for normal computer-only use.
# For an explicit temporary tunnel, configure its trusted host/origin and
# require a strong key. Never put this key in VITE_* or public frontend code.
REQUIRE_API_KEY=false
LOCAL_API_KEY=

# Blog rollout switches: leave false until reviewed migration and staging tests.
VITE_ENABLE_BLOG_ADMIN=false
VITE_ENABLE_LIVE_BLOG=false

# Explicit staging text publication only. Keep disabled until reviewed.
VITE_ENABLE_BLOG_PUBLICATION=false

# Server-side isolated SEO Preview only; do not enable in Production.
BLOG_SEO_PREVIEW=false
BLOG_SEO_SUPABASE_URL=
BLOG_SEO_SUPABASE_PUBLISHABLE_KEY=
