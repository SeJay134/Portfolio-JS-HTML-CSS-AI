# Public frontend configuration. Never place secrets in VITE_* variables.
# Local development uses Vite's /api proxy when this is empty.
# Production: set a stable HTTPS backend base URL without /chat.
VITE_API_BASE_URL=
FRONTEND_URLS=http://localhost:5001,http://127.0.0.1:5001,https://sergei-luna.vercel.app
OLLAMA_HOST=http://localhost:11434
MODEL_NAME=qwen2.5:7b
MODEL_TIMEOUT=45
MAX_GENERATIONS=1
CHAT_LIMIT=10/minute
# Use Redis for production/multiple workers; memory is for local development only.
RATELIMIT_STORAGE_URI=memory://
RAG_MAX_DISTANCE=1.4
