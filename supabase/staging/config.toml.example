# Copied only to a private disposable work directory by the launcher.
project_id = "sergei-portfolio-oauth-staging"
[api]
enabled = true
port = 54321
schemas = ["public", "graphql_public"]
extra_search_path = ["public", "extensions"]
max_rows = 1000
[db]
port = 54322
shadow_port = 54320
major_version = 17
[db.seed]
enabled = false
[auth]
enabled = true
site_url = "http://127.0.0.1:5511"
additional_redirect_urls = ["http://127.0.0.1:5511/auth/callback/"]
jwt_expiry = 3600
enable_signup = true
enable_anonymous_sign_ins = false
enable_manual_linking = false
[auth.email]
enabled = false
[auth.sms]
enabled = false
[auth.external.google]
enabled = true
client_id = "env(STAGING_GOOGLE_CLIENT_ID)"
secret = "env(STAGING_GOOGLE_CLIENT_SECRET)"
redirect_uri = "http://127.0.0.1:54321/auth/v1/callback"
skip_nonce_check = false
